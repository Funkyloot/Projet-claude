# Copier ce fichier en .env puis remplir les valeurs. Ne jamais versionner .env.

# --- Mode ---
# simulation : aucun argent réel ; reel : recommandations pour de vraies mises
MOTEUR_MODE=simulation

# --- Capital et règles de mise (cahier des charges, section 2 et 9) ---
MOTEUR_CAPITAL_INITIAL=100
MOTEUR_SEUIL_ARRET=60
MOTEUR_FRACTION_KELLY=0.25
MOTEUR_MISE_MAX_PCT=0.03
MOTEUR_VALEUR_MIN=0.03
MOTEUR_AGE_MAX_COTE_S=60

# --- Base de données ---
# Docker Compose fournit PostgreSQL. Hors Docker, SQLite suffit :
# MOTEUR_DATABASE_URL=sqlite:///data/moteur.db
MOTEUR_DATABASE_URL=postgresql+psycopg://moteur:moteur@db:5432/moteur
POSTGRES_PASSWORD=moteur

# --- Clés API (étapes suivantes) ---
MOTEUR_ANTHROPIC_API_KEY=
MOTEUR_ODDS_API_KEY=
MOTEUR_TELEGRAM_TOKEN=
MOTEUR_TELEGRAM_CHAT_ID=
