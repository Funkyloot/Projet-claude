# Facultatif : tout se règle dans l'interface web (http://<adresse-du-serveur>:8080 › Réglages).
# Ce fichier ne sert qu'à qui préfère régler par variables d'environnement.
# Les réglages saisis dans l'interface sont prioritaires sur ceux-ci.

# Mot de passe interne de la base PostgreSQL (jamais exposée hors de Docker)
POSTGRES_PASSWORD=moteur

# Port de l'interface web
MOTEUR_PORT_WEB=8080

# Exemples de réglages (modifiables aussi dans l'interface)
# MOTEUR_FUSEAU=Europe/Paris
# MOTEUR_CAPITAL_INITIAL=100
# MOTEUR_SEUIL_ARRET=60
# MOTEUR_TELEGRAM_TOKEN=
# MOTEUR_ODDS_API_KEY=
