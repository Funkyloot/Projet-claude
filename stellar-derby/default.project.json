{
  "name": "StellarDerby",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Partage": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Serveur": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "ServerStorage": {
      "Ressources": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Arbres": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Buissons": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Rochers": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    }
  }
}
