{
  "name": "calme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Un compagnon pixel pour souffler — PWA installable sur iOS",
  "scripts": {
    "icones": "node tools/gen-icons.mjs",
    "monofichier": "node tools/build-monofichier.mjs",
    "servir": "cd web && python3 -m http.server 8777",
    "pistonville": "node tools/build-pistonville.mjs",
    "pistonville:servir": "cd pistonville && python3 -m http.server 8778",
    "pistonville:serveur": "node tools/build-pistonville.mjs && node tools/serveur-pistonville.mjs",
    "pistonville:icones": "node tools/pistonville-icones.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
